{
  "name": "scriptorium",
  "version": "0.1.0",
  "description": "Agentic narrative scaffolding: director, writer, critic, archivist roles over swappable models",
  "type": "module",
  "bin": {
    "scriptorium": "src/cli.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "demo": "node --env-file=.env src/cli.ts run --config story.config.json --out runs/demo",
    "story": "node --env-file=.env src/cli.ts run --config story.opencode-go.config.json",
    "story:mock": "node --env-file=.env src/cli.ts run --config story.config.json",
    "make": "node --env-file-if-exists=.env src/cli.ts make",
    "art": "node --env-file=.env src/cli.ts art --config story.opencode-go.config.json",
    "artdirect": "node --env-file=.env src/cli.ts artdirect --config story.opencode-go.config.json",
    "video": "node src/cli.ts video",
    "cast": "node --env-file-if-exists=.env src/cli.ts cast",
    "pitch": "node --env-file-if-exists=.env src/cli.ts pitch",
    "approve": "node src/cli.ts approve",
    "review": "node src/cli.ts review",
    "reshoot": "node --env-file-if-exists=.env src/cli.ts reshoot",
    "doctor": "node src/cli.ts doctor",
    "audition": "node src/cli.ts audition",
    "canon": "node src/cli.ts canon",
    "spend": "node src/cli.ts spend",
    "cleanup": "node src/cli.ts cleanup"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  }
}
