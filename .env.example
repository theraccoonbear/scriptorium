# Copy to .env and fill in the keys you need (`npm run doctor` shows what each unlocks).
# .env is git-ignored and always wins over your shell's environment.

# Writing: every Claude role. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Images, image checks, acted voices, music. Needs billing on the Google project.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional writing backends, only if your config uses them:
# OPENAI_API_KEY=      # "responses" providers
# OPENCODE_API_KEY=    # "opencode-go" providers
